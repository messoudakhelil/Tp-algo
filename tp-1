#include <stdio.h>

// 1. Linear Search
int linearSearch(int A[], int n, int x)
{
    for (int i = 0; i < n; i++)
    {
        if (A[i] == x)
            return i;
    }

    return -1;
}


// 2. Linear Search in Sorted Array
int sortedLinearSearch(int A[], int n, int x)
{
    for (int i = 0; i < n; i++)
    {
        if (A[i] == x)
            return i;

        if (A[i] > x)
            return -1;
    }

    return -1;
}


// 3. Binary Search
int binarySearch(int A[], int n, int x)
{
    int left = 0;
    int right = n - 1;

    while (left <= right)
    {
        int mid = (left + right) / 2;

        if (A[mid] == x)
            return mid;

        if (A[mid] < x)
            left = mid + 1;
        else
            right = mid - 1;
    }

    return -1;
}


int main()
{
    int A[] = {2, 4, 6, 8, 10, 12, 14};
    int n = 7;
    int x;


    printf("Enter the value to search: ");
    scanf("%d", &x);

    printf("Linear Search: %d\n", linearSearch(A, n, x));

    printf("Sorted Linear Search: %d\n",
           sortedLinearSearch(A, n, x));

    printf("Binary Search: %d\n",
           binarySearch(A, n, x));

    return 0;
}
